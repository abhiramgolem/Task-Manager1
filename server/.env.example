# SmartTask backend — environment template.
# Copy to `server/.env` and fill in. NEVER commit your real .env (it's gitignored).

PORT=4000
# Strong random string for signing JWTs. On Render this is auto-generated.
JWT_SECRET=change-me-in-production-please

# ---- Google Sign-In (optional; enables the "Continue with Google" button) ----
# The Web OAuth client id from Google Cloud Console (see docs/GOOGLE_SIGNIN_SETUP.md).
# MUST match the client's VITE_GOOGLE_CLIENT_ID. Leave empty to disable Google login.
GOOGLE_CLIENT_ID=
# Only for the Android/iOS app: the extra platform OAuth client id(s), comma-separated.
# Native id tokens carry the mobile client id in `aud`, so it must be accepted too.
GOOGLE_CLIENT_IDS_EXTRA=

# ---- AI engine (optional; app falls back to the offline rule-based engine) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
# Only for an OpenAI-compatible gateway, or the stand-in model `npm run mock:model`
# serves for trying meeting analysis without a key (http://localhost:4199/v1).
OPENROUTER_BASE_URL=

# ---- Live meeting analysis (src/ai/liveAnalysis.js) ----
# While a meeting is recorded, every N seconds of recording the newest stretch is
# analysed, so pressing Analyze at the end only reads the last few minutes. Needs
# one of the AI keys above; with none it stays off. `off` turns it off regardless.
MEETING_LIVE_ANALYSIS=
# 600 = every ten minutes. Set 60 on localhost to watch it work within a minute.
MEETING_LIVE_CHUNK_SECONDS=600

# ---- Audio transcription (optional) ----
TRANSCRIPTION_PROVIDER=sarvam
OPENAI_TRANSCRIBE_MODEL=whisper-1
SARVAM_API_KEY=
SARVAM_LANGUAGE=en-IN

# ---- Assistant voice / text-to-speech (optional) ----
# ElevenLabs gives the voice assistant a natural voice instead of the device's
# built-in one. Leave blank and it falls back to Android TTS / speechSynthesis —
# the assistant still speaks, it just sounds like a screen reader.
# Billed per CHARACTER; usage is recorded per org under the 'voice_tts' feature.
# NOTE: this file is COMMITTED — it is the template, not your config. Put the real
# key in server/.env, which is git-ignored. Leave this blank.
ELEVENLABS_API_KEY=
# Voice to use. Default is Rachel (21m00Tcm4TlvDq8ikWAM) — calm and neutral.
# Browse others at elevenlabs.io/app/voice-library and paste the voice ID here.
ELEVENLABS_VOICE_ID=
# Turbo is the default: measured fastest on this app's actual sentences (~0.5-0.6s
# round-trip vs ~0.8s for flash and ~1.3-2.6s for eleven_v3). Latency matters more
# than expressiveness here — every reply is one short status line, and the loop only
# re-opens the mic after the assistant finishes speaking. See src/ai/speech.js.
ELEVENLABS_MODEL=eleven_turbo_v2_5

# ---- Daily task digest (optional) ----
CLIQ_WEBHOOK_URL=
DIGEST_HOUR=8

# ---- Per-owner task mail (src/taskMail.js) ----
# Addressed mail, one recipient per message, unlike the team digest above.
# Three triggers: the daily list (critical first, then everything else open), an
# alert within a minute of a Critical task being assigned, and a warning one hour
# before a Critical task's deadline.
#
# THE GATE. Only the word 'true' (any capitalisation) sends to real owners.
# Anything else — unset, empty, 'false', '1', 'yes' — redirects every message to
# TASK_MAIL_TEST_TO instead, banner included. Leave it off until the rehearsal
# has been reviewed.
TASK_MAIL_TO_OWNERS=false
# Where rehearsal mail goes. Gate off and this empty = nothing is sent at all.
TASK_MAIL_TEST_TO=
# Hours below are read in THIS zone, not the server's. Render runs in UTC, so
# without this "10" would mean 15:30 to everyone actually reading the mail.
TASK_MAIL_TZ=Asia/Kolkata
TASK_MAIL_DAILY_HOUR=10
# Wall-clock "HH:MM" slots, read in TASK_MAIL_TZ. TASK_MAIL_DAILY_AT overrides the
# hour above when set. The critical-only pass needs minutes, so it has no
# hour-only form. Both fire if their slot has passed and the day's send hasn't
# happened yet, so a restart over the slot still delivers, once, late.
TASK_MAIL_DAILY_AT=10:00
# Second daily pass, CRITICAL tasks only, to the people who own some.
TASK_MAIL_CRITICAL_AT=13:30
# due_date carries no time of day, so the deadline needs an hour to mean anything.
# 18 = end of the working day; the one-hour warning then goes out at 17:00.
TASK_MAIL_DEADLINE_HOUR=18

# ---- Email (Brevo SMTP) — powers verification, password reset & team invites ----
# Sender domain must be authenticated in Brevo for good deliverability.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=          # your Brevo LOGIN email (Brevo → SMTP & API → Login)
SMTP_PASS=          # your Brevo SMTP KEY  (Brevo → SMTP & API → Generate a new SMTP key)
MAIL_FROM=Befach Task Manager <noreply@taskmanager.befach.com>

# Base URL for links inside emails. Local: http://localhost:5173
# Production (Render): your public app URL, e.g. https://smarttask-api-xxxx.onrender.com
APP_URL=http://localhost:5173
